# Copy this file to .env and paste your key. Never commit .env.
# Any OpenAI-compatible API works. Demo uses Google Gemini (key from aistudio.google.com).
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FEATHERLESS_MODEL=gemini-3.6-flash
# Optional: a lighter backup model used when the main model is busy
FEATHERLESS_FALLBACK_MODEL=gemini-3.5-flash-lite
